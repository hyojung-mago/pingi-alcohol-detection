# Pingi-AI 환경 변수

# PostgreSQL (Docker 내부: pingi-postgres, 로컬 개발: localhost)
DATABASE_URL=postgresql://postgres:password@pingi-postgres:5432/pingi

# pingi-backend의 업로드 폴더 경로 (Docker: /app/uploads, 로컬: ../pingi-backend/uploads)
UPLOAD_BASE=/app/uploads

# 서버 포트 (기본 8001)
PORT=8001

# 임시 파일 디렉토리 (Docker: /app/tmp, 로컬: 미설정 시 OS 기본 /tmp)
# TEMP_DIR=/app/tmp

# Whisper STT API (Mago) — 비활성화 상태에서는 불필요
# WHISPER_BASE_URL=https://op1-api.magovoice.com/whisper
# WHISPER_ENABLED=false
